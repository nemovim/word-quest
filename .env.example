# Database
MONGO_URI=mongodb://localhost:27017/word-quest

# Authentication
AUTH_SECRET=replace-with-a-long-random-value
GOOGLE_ID=
GOOGLE_SECRET=

# Admin access (comma-separated Google account emails)
ADMIN_EMAILS=admin@example.com

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_DECISION_MODEL=perplexity/pplx-decider-v1.2
VOCA_SCORE_MIN_CONFIDENCE=0.35
VOCA_VALIDITY_MIN_CONFIDENCE=0.8
